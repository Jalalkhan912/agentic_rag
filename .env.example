# Copy this file to .env and fill in your values
# Never commit .env to git

# ── LLM provider ──────────────────────────────────────────────────────────
# Option A: OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option B: Google Gemini free tier (key from https://aistudio.google.com/apikey)
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-3.6-flash
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001

# ── Database ──────────────────────────────────────────────────────────────
# Overridden by docker-compose to use the 'postgres' service hostname
DATABASE_URL=postgresql+asyncpg://rag_user:rag_pass@localhost:5432/rag_db
# Host port docker-compose publishes Postgres on (change if 5432 is taken)
POSTGRES_HOST_PORT=5432

# ── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
MAX_FILE_SIZE_MB=50

# ── AWS (filled in when setting up CI/CD — Step 6) ────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# ECR_REGISTRY=
